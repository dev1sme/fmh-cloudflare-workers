# Headers for the static SPA (HTML, JS, CSS).
#
# These cannot be set in the Worker: `run_worker_first = ["/api/*", "/hooks/*"]` in
# wrangler.toml means Cloudflare serves every non-API path straight from the
# assets store without ever invoking the Worker. API responses get their own
# headers from `securityHeaders` in src/server/headers.ts — keep the two in
# step when changing anything here.
#
# Vite copies this file verbatim into dist/client/, which is the assets
# directory. Cloudflare reads it as configuration and does not serve it.
#
# script-src carries a sha256 rather than 'unsafe-inline'. index.html has one
# inline script — the colour-scheme guard that runs before first paint — and a
# hash allows exactly those bytes while every other inline script stays
# blocked. Edit that script and the hash must be regenerated, or it is silently
# refused and the theme flashes on load:
#
#   npm run build
#   python3 -c "import base64,hashlib,re,pathlib; \
#     b=re.search(r'<script>(.*?)</script>', \
#     pathlib.Path('dist/client/index.html').read_text(), re.S).group(1); \
#     print('sha256-'+base64.b64encode(hashlib.sha256(b.encode()).digest()).decode())"

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  X-Frame-Options: DENY
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-nyoJm9mWbRF7ICtQkKBiUnOf8mFUlg1A8fHfQldVqJw='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
